# =============================================================================
# Collab Office — 环境变量样例
# -----------------------------------------------------------------------------
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env   (Windows: copy .env.example .env)
#   2. 按需修改下面的值
#   3. .env 会被 docker compose 自动读取,也会被 start-dev.ps1 注入给后端进程
#
# 注意: .env 已在 .gitignore 中,不会提交,可放真实密钥。
# =============================================================================

# ---- JWT (所有服务共用,必填,否则服务启动失败) ----
# 生产请换成足够长的随机串,开发可用下面的默认值
JWT_SECRET=collab-office-dev-jwt-secret-change-me-in-production-32chars

# ---- 服务间内部调用 Token (网关/部分服务校验,必填) ----
INTERNAL_CALL_TOKEN=collab-internal-dev-token-change-me

# ---- MySQL ----
DB_USERNAME=root
DB_PASSWORD=root

# ---- Redis (本 docker 配置未设密码,留空即可) ----
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- MinIO ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=doc-files

# Docker 中对浏览器公开的 MinIO 地址（服务间调用仍使用 http://minio:9000）
DOCKER_MINIO_PUBLIC_ENDPOINT=http://localhost:19000

# ---- Nacos ----
NACOS_ADDR=localhost:8848

# ---- Elasticsearch (本配置未开启安全,无需账号密码) ----

# ---- SMTP 邮件 (notification-service 用,不发邮件可留空) ----
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=

# ---- 日志级别 ----
LOG_LEVEL=INFO

# ---- Docker 对宿主机开放的端口 ----
# 默认避开常见的 3000/8080/3306，防止与本机开发服务冲突。
WEB_PORT=3030
GATEWAY_PORT=18090
MYSQL_PORT=13306
REDIS_PORT=16380
RABBITMQ_AMQP_PORT=15674
RABBITMQ_MANAGEMENT_PORT=15673
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
ELASTICSEARCH_PORT=19200
NACOS_PORT=18848
MAILPIT_PORT=18025
